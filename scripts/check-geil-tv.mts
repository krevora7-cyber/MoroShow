import {providerJson,catalogPath,upstream} from '../src/server/geilTv';import{writeFile}from'node:fs/promises';
const out:any={checkedAt:new Date().toISOString(),catalog:false,resolver:false,manifest:false,segment:false,nativeIPhoneTested:false};
try{const d=await providerJson(catalogPath('bein','',''));out.catalog=Array.isArray(d.items)&&d.items.length>0;out.firstPageCount=d.items?.length;out.hasMore=d.nextCursor!=null;const channel=d.items.find((i:any)=>/BEIN SPORT HD 1 /i.test(i.name))||d.items.find((i:any)=>/SPORT.*1/i.test(i.name))||d.items[0];out.channel=channel.name;
const r=await fetch('https://geil.to/live/resolve?'+new URLSearchParams({url:channel.url}),{signal:AbortSignal.timeout(20000)});const data=await r.json();out.resolver=!!data.url;if(data.url){const ac=new AbortController();const t=setTimeout(()=>ac.abort(),12000);try{const {response,url}=await upstream(data.url,ac.signal);out.upstreamStatus=response.statusCode;let text='';for await(const b of response){text+=b.toString();if(text.length>100000){response.destroy();break;}}out.manifest=text.trimStart().startsWith('#EXTM3U');if(out.manifest){const uri=text.split(/\r?\n/).find((l:string)=>l.trim()&&!l.startsWith('#'));if(uri){const next=await upstream(new URL(uri,url).href,ac.signal);const first=await next.response[Symbol.asyncIterator]().next();out.segment=next.response.statusCode===200&&first.value?.length>0;out.sampleBytes=first.value?.length||0;next.response.destroy();}}}catch(e:any){out.playbackError=e.code||e.message;}finally{clearTimeout(t);ac.abort();}}}catch(e:any){out.error=e.message;}
await writeFile('verification/geil-live-4120.json',JSON.stringify(out,null,2));console.log(JSON.stringify(out,null,2));
