# Set only when the external HTTPS backend is ready.
VITE_NETSHOW_API_BASE=
# Backend-only secret; never set a VITE_ prefix for this key.
TMDB_API_KEY=

# Supabase browser configuration (public values, Vercel Config variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same project, set on the backend. Never use service_role in a browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend-only catalog of authorized direct video URLs, keyed by MoroShow title/episode ID.
# Use HTTPS, HLS or MP4. For HLS, allow cross-origin access to the manifest and segments.
# Example: {"w32:movie:42":[{"id":"native-1","label":"Main","streamUrl":"https://media.example.invalid/42.mp4","streamType":"mp4"}]}
MOROSHOW_NATIVE_HLS_CATALOG=

# Set to direct-only after configuring authorized, ad-free media for the catalog.
MOROSHOW_MOVIE_PLAYBACK=
