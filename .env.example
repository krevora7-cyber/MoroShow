# Set only when the external HTTPS backend is ready.
VITE_NETSHOW_API_BASE=
# Backend-only secret; never set a VITE_ prefix for this key.
TMDB_API_KEY=

# Supabase browser configuration (public values, Vercel Config variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same project, set on the backend. Never use service_role in a browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
