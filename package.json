    "@capacitor/ios": "^7.0.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "artplayer": "^5.4.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mpegts.js": "^1.8.2",
    "node-cache": "^5.1.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "swiper": "^14.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
