{
  "name": "moroshow",
  "private": true,
  "version": "4.12.9",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "diagnose": "node scripts/diagnose.mjs",
    "build": "vite build",
    "start": "node --import tsx server.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test src/utils/*.test.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:sources": "node --experimental-strip-types --test src/server/netshowSources.test.ts",
    "test:gateway": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser-engine": "node --experimental-strip-types --test tests/chromeProviderEngine.test.mjs tests/chromeProviderHttp.test.mjs",
    "diagnose:gateway": "node --experimental-strip-types scripts/check-addon-gateway.mjs",
    "test:live": "node --import tsx scripts/test-live-cnc.mjs",
    "test:web-sources": "node --import tsx --test tests/webSources.test.ts tests/dramaPlayback.test.ts",
    "test:shorts": "node --import tsx --test tests/shortProviders.test.ts",
    "diagnose:shorts": "node --import tsx scripts/check-shorts-live.mjs",
    "test:drama-current": "node --import tsx --test tests/dramaCurrent.test.ts",
    "test:player-ui": "node --import tsx --test tests/playerPresentation.test.ts",
    "test:shorts-fixes": "node --import tsx --test tests/shorts498.test.ts tests/shorts499.test.ts",
    "test:continuation": "node --import tsx --test tests/continuation4110.test.ts tests/profiles4110.test.ts",
    "test:playback-update": "node --import tsx --test tests/publicTv.test.ts tests/publicTvRoutes.test.ts tests/shortsPreparation.test.ts tests/browserPlayback.test.ts tests/webSources.test.ts tests/dramaCurrent.test.ts tests/accountAuth.test.ts tests/geilTv.test.ts"
  },
  "dependencies": {
